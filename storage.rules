rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUpload() {
      return request.resource != null
        && request.resource.size <= 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    // Company-scoped file storage (property images, KYC PDFs, agreement templates, logos)
    match /companies/{companyId}/{folder}/{allFiles=**} {
      allow read: if isSignedIn()
        && folder in ['properties', 'kyc', 'documents', 'branding']
        && (
          request.auth.token.companyId == companyId ||
          request.auth.token.role == 'super_admin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.companyId == companyId
        );

      allow write: if isSignedIn()
        && folder in ['properties', 'kyc', 'documents', 'branding']
        && isValidUpload()
        && (
          request.auth.token.companyId == companyId ||
          request.auth.token.role == 'super_admin' ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.companyId == companyId
        );
    }
  }
}
